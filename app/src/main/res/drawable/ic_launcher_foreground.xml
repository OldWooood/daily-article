<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景：朱砂印章 + 「文」。
  藏书印是文人传统，与"每日一文"的文学定位同源；朱砂红在桌面上也足够醒目。
  印章 30~78（48dp），居 108dp 画布中央 72dp 安全区内。
  「文」用圆头描边手绘：点、横、撇、捺四笔，笔画中心线落在印章视觉中心。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 印章：圆角方，朱砂红 -->
    <path
        android:fillColor="#C8402A"
        android:pathData="M40,30 H68 A10,10 0 0 1 78,40 V68 A10,10 0 0 1 68,78 H40 A10,10 0 0 1 30,68 V40 A10,10 0 0 1 40,30 Z" />

    <!-- 「文」：纸白色。点是圆点（非竖笔）且与横拉开距离，否则缩略后像「大」「六」 -->
    <path
        android:fillColor="#FDF9F2"
        android:pathData="M51,37 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FDF9F2"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M41,48.5 H67" />
    <!-- 撇捺交叉：起笔左右拉开，交点压到横下约 7 处，与横围出倒三角形 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FDF9F2"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M63,48.5 C57,56 45,63 37,70" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FDF9F2"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M45,48.5 C51,56 63,63 71,70" />
</vector>
