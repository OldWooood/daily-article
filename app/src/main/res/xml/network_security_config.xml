<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认禁止明文流量，强制 HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- ONE·一个 官方接口只提供 HTTP，为其单独放行 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">v3.wufazhuce.com</domain>
    </domain-config>

    <!-- debug 包允许用户 CA（Charles/Fiddler 抓包），release 不受影响 -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
