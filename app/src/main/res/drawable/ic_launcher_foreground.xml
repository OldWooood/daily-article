<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景：一页文稿。
  刻意避开"翻开的书"这类烂俗符号 —— 直接画一张纸 + 几行文字，
  对应"每日一文"的产品本质：每天读一篇。

  全部图形控制在 108dp 画布中央 72dp 的安全区内（自适应图标会被裁成圆形/圆角），
  因此页面的 x 范围取 30~78，y 范围取 26~82。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 纸张主体：顶部带一个小折角，表示"一张纸"而非矩形色块 -->
    <path
        android:fillColor="#2E2A25"
        android:pathData="M30,26 L63,26 L78,41 L78,82 L30,82 Z" />

    <!-- 折角（米色回折，暗示翻页） -->
    <path
        android:fillColor="#F0E7D6"
        android:pathData="M63,26 L63,41 L78,41 Z" />

    <!-- 正文文字行：长短交错，第 2 行留白模拟段落节奏 -->
    <path android:fillColor="#F7F2E8" android:pathData="M38,49h32v4h-32z" />
    <path android:fillColor="#F7F2E8" android:pathData="M38,58h32v4h-32z" />
    <path android:fillColor="#F7F2E8" android:pathData="M38,67h32v4h-32z" />
    <path android:fillColor="#F7F2E8" android:pathData="M38,76h20v4h-20z" />
</vector>
